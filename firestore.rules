rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0;
      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'updatedAt']);
    }

    match /groups/{groupId} {
      allow get: if isActiveMember(groupId);
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update: if isActiveMember(groupId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'lastActivityAt', 'lastActivityPreview']);
      allow delete: if false;
    }

    match /groups/{groupId}/members/{userId} {
      allow get: if isActiveMember(groupId) || isUser(userId);
      allow list: if isActiveMember(groupId);
      allow create: if isUser(userId)
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.status == 'active'
        && request.resource.data.role == 'owner'
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == userId;
      allow update: if false;
      allow delete: if false;
    }

    match /groups/{groupId}/messages/{messageId} {
      allow read: if isActiveMember(groupId);
      allow create: if isActiveMember(groupId)
        && request.resource.data.keys().hasOnly([
          'type', 'authorId', 'authorDisplayNameSnapshot', 'text', 'createdAt', 'clientRequestId'
        ])
        && request.resource.data.type == 'text'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorDisplayNameSnapshot is string
        && request.resource.data.authorDisplayNameSnapshot.size() > 0
        && request.resource.data.authorDisplayNameSnapshot.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.text.matches('.*\\S.*')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.clientRequestId is string
        && request.resource.data.clientRequestId.size() > 0
        && request.resource.data.clientRequestId.size() <= 120;
      allow update, delete: if false;
    }

    match /users/{userId}/groups/{groupId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && request.resource.data.groupId == groupId
        && request.resource.data.status == 'active'
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(userId)).data.status == 'active';
      allow update, delete: if false;
    }

    match /invites/{inviteId} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isActiveMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.status == 'active';
    }
  }
}
