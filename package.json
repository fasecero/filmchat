{
  "name": "filmchatapp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "jest-expo": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.9.8",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:rules",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=tests/firestore.rules.test.ts",
    "test:rules": "firebase emulators:exec --project demo-filmchat --only firestore \"npm run test:rules:raw\"",
    "test:rules:raw": "jest --runInBand tests/firestore.rules.test.ts",
    "emulators": "firebase emulators:start --project demo-filmchat --only auth,firestore,functions",
    "emulators:export": "firebase emulators:start --project demo-filmchat --only auth,firestore,functions --export-on-exit=.firebase/emulator-data"
  },
  "private": true
}
